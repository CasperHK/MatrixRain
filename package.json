{
  "name": "matrix-digital-rain",
  "version": "0.1.1",
  "private": false,
  "description": "Matrix digital rain effect library built with TypeScript and rslib",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./qwik": {
      "types": "./dist/qwik.d.ts",
      "import": "./dist/qwik.js",
      "require": "./dist/qwik.cjs",
      "default": "./dist/qwik.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs",
      "default": "./dist/solid.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs",
      "default": "./dist/angular.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs",
      "default": "./dist/svelte.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@builder.io/qwik": ">=1.0.0",
    "react": ">=18.0.0",
    "solid-js": ">=1.0.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.0.0"
  },
  "scripts": {
    "dev": "rslib dev",
    "build": "rslib build",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "matrix",
    "canvas",
    "effect",
    "library",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@angular/core": "^20.0.0",
    "@builder.io/qwik": "^1.14.1",
    "@rslib/core": "^0.7.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "solid-js": "^1.8.17",
    "svelte": "^5.0.0",
    "typescript": "^5.5.4",
    "vue": "^3.5.13"
  }
}
